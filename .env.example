# Copy to .env.local and fill in. .env.local is gitignored — never commit real secrets.

# Postgres connection string. Local dev: postgres://user:pass@localhost:5432/omnisocial
# Production (Vercel Postgres): copy the POSTGRES_URL Vercel generates when you
# create the Postgres store and attach it to this project.
DATABASE_URL=

# Single-admin login. Generate the hash with:
#   node -e "console.log(require('bcryptjs').hashSync('your-password', 10))"
# IMPORTANT: Next.js expands $VAR / ${VAR} inside .env files, and a bcrypt
# hash is full of literal $ characters (e.g. $2b$10$...) — escape every $ as
# \$ or Next.js will silently mangle the hash and every login will fail.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=

# Random secret for signing session JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=

# 32-byte key (as 64 hex chars) used to encrypt platform credentials at rest
# (AES-256-GCM). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MASTER_KEY=

# Optional. Only needed in production for image uploads — Vercel provisions
# this automatically when you add a Blob store to the project. Leave unset
# for local dev; uploads fall back to writing into public/uploads/.
BLOB_READ_WRITE_TOKEN=
